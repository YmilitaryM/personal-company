# AI Dev Team — API Keys for LiteLLM Gateway
# 复制此文件为 .env 并填写你的 API key
# cp config/.env.example .env

# DeepSeek (https://platform.deepseek.com/api-keys)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (https://console.anthropic.com/settings/keys)
# 如果希望同时用 Claude 官方模型，填写此项
ANTHROPIC_API_KEY=sk-ant-your-key

# 通义千问 / Qwen (https://dashscope.console.aliyun.com/apiKey)
DASHSCOPE_API_KEY=sk-your-dashscope-key

# LiteLLM 管理密码（用于访问 Web UI，自动生成也可）
LITELLM_MASTER_KEY=sk-litellm-your-master-key
